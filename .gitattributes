# Finales de línea LF en todo el proyecto (Windows y servidor Linux), sin avisos de CRLF
* text=auto eol=lf

# Scripts de Windows: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca se convierten
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.heic binary
*.pdf binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
