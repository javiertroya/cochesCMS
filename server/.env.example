# ── Base de datos ───────────────────────────────────────────────────────────
# Con docker-compose, DB_HOST se fuerza a "db". Estos valores deben coincidir
# con los de docker-compose.yml (son los mismos por defecto).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coches_cms
DB_USER=coches_user
DB_PASSWORD=coches_dev_password

# ── Seguridad ───────────────────────────────────────────────────────────────
# development · production. En production la API oculta /docs y NO arranca si
# JWT_SECRET_KEY, DB_PASSWORD o CORS_ORIGINS tienen valores de ejemplo o débiles.
# La imagen Docker ya es production por defecto; docker-compose.yml (desarrollo) fija development.
APP_ENV=development

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia_esto_por_un_valor_largo_y_aleatorio

# Orígenes permitidos para el frontend (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Almacenamiento de archivos ──────────────────────────────────────────────
# local = guarda en server/uploads (desarrollo) · r2 = Cloudflare R2
STORAGE_DRIVER=local
MAX_IMAGE_MB=25
MAX_VIDEO_MB=200

# Solo si STORAGE_DRIVER=r2 (Cloudflare → R2 → Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=coches-public
R2_PRIVATE_BUCKET=coches-private
# Dominio público conectado al bucket público, sin barra final
R2_PUBLIC_URL=https://img.tudominio.com

# ── Correo (fase 3: Brevo o Resend por SMTP) ────────────────────────────────
# En desarrollo puedes usar Mailpit (incluido en docker-compose): SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_USE_TLS=false y ver los correos en http://localhost:8025
# El correo que recibe los avisos se configura en el panel (Estilos → Solicitudes);
# ADMIN_NOTIFICATION_EMAIL se usa si ese campo está vacío.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
MAIL_FROM=web@tudominio.com
ADMIN_NOTIFICATION_EMAIL=admin@tudominio.com

# ── Analítica (opcional) ────────────────────────────────────────────────────
